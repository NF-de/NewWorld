{% extends 'base.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block body %}
<style>
    .example-wrapper {
        margin: 1em auto;
        max-width: 800px;
        width: 95%;
        font: 18px/1.5 sans-serif;
    }

    .example-wrapper code {
        background: #F5F5F5;
        padding: 2px 6px;
    }
</style>

<div class="example-wrapper">
    {% if is_granted('ROLE_USER') %}
    <a href=" {{ path('app_logout') }} ">Se déconnecter</a>
    {% else %}
    <a href=" {{ path('app_register') }} ">S'inscrire</a>
    <a href=" {{ path('app_login') }} ">Se connecter</a>
    {% endif %}
</div>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>/home/kopse/Documents/DEV/AP/NewWorld/src/Controller/MainController.php</code></li>
        <li>Your template at <code>/home/kopse/Documents/DEV/AP/NewWorld/templates/main/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}