{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur NewWorld{% endblock %}

{% block body %}
<style>
    body {
        font-family: 'Times New Roman', serif;
        background-color: #ffffff;
        color: #000000;
        margin: 0;
        padding: 0;
    }

    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 30px;
        background-color: #f5f5f5;
        border-bottom: 1px solid #ccc;
        position: sticky;
        top: 0;
    }

    .navbar .logo {
        font-weight: bold;
        font-size: 1.5rem;
        color: #000;
        text-decoration: none;
    }

    .navbar .nav-links a {
        margin-left: 10px;
        text-decoration: none;
        padding: 8px 16px;
        font-size: 0.95rem;
        font-weight: bold;
        border-radius: 5px;
        border: 1px solid transparent;
        transition: 0.3s;
    }

    .navbar .nav-links a.register {
        background-color: #e0e0e0;
        color: #000;
        border-color: #bbb;
    }

    .navbar .nav-links a.login {
        background-color: #d4d4d4;
        color: #000;
        border-color: #aaa;
    }

    .navbar .nav-links a.logout {
        background-color: #f8d7da;
        color: #a00;
        border-color: #f5c2c7;
    }

    .navbar .nav-links a:hover {
        filter: brightness(0.9);
        cursor: pointer;
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 70vh;
        padding: 50px 20px;
    }

    .hero h1 {
        font-size: 2rem;
        margin-bottom: 15px;
        color: #000;
    }

    .hero p {
        font-size: 1rem;
        color: #333;
    }
</style>

<div class="navbar">
    <a href="/" class="logo">NewWorld</a>
    <div class="nav-links">
        {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_logout') }}" class="logout">Se déconnecter</a>
        {% else %}
        <a href="{{ path('app_register') }}" class="register">S'inscrire</a>
        <a href="{{ path('app_login') }}" class="login">Se connecter</a>
        {% endif %}
    </div>
</div>

<div class="hero">
    <h1>Bienvenue sur NewWorld</h1>
    <p>Connectez-vous ou inscrivez-vous pour accéder à toutes nos fonctionnalités.</p>
</div>

{% endblock %}
