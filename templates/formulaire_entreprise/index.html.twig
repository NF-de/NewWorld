{% extends 'base.html.twig' %}

{% block title %}Demande création entreprise{% endblock %}

{% block body %}
<link href="{{ asset('styles/formulaire_entreprise.css') }}" type="text/css" rel="stylesheet" />

<div class="form-container">
    <h1>Formulaire Entreprise</h1>

    {{ form_start(form) }}
    {# On laisse Symfony générer les lignes, mais on personnalise l'affichage #}

    <div class="form-group">
        {{ form_label(form.nom) }}
        {{ form_widget(form.nom, {'attr': {'placeholder': 'Nom de l\'entreprise'}}) }}
        {{ form_errors(form.nom) }}
    </div>

    <div class="form-group">
        {{ form_label(form.adresse) }}
        {{ form_widget(form.adresse, {'attr': {'placeholder': 'Adresse'}}) }}
        {{ form_errors(form.adresse) }}
    </div>

    <div class="form-row-multi">
        <div class="form-group">
            {{ form_label(form.ville) }}
            {{ form_widget(form.ville, {'attr': {'placeholder': 'Ville'}}) }}
        </div>
        <div class="form-group">
            {{ form_label(form.code_postal) }}
            {{ form_widget(form.code_postal, {'attr': {'placeholder': 'Code Postal'}}) }}
        </div>
    </div>

    <div class="form-group">
        {{ form_label(form.siret) }}
        {{ form_widget(form.siret, {'attr': {'placeholder': 'SIRET'}}) }}
    </div>

    <div class="form-group">
        {{ form_label(form.email) }}
        {{ form_widget(form.email, {'attr': {'placeholder': 'Email'}}) }}
    </div>

    <div class="form-group">
        {{ form_label(form.telephone) }}
        {{ form_widget(form.telephone, {'attr': {'placeholder': 'Téléphone'}}) }}
    </div>

    <button type="submit" class="bouton">Envoyer</button>
    {{ form_end(form) }}
</div>
{% endblock %}