{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<link href="{{ asset('styles/login.css') }}" type="text/css" rel="stylesheet" />

<h1>Inscription</h1>

<form method="post">

    {{ form_errors(registrationForm) }}

    <input type="text" name="{{ registrationForm.nom.vars.full_name }}" placeholder="Nom"
        value="{{ registrationForm.nom.vars.value }}" required>

    <input type="text" name="{{ registrationForm.prenom.vars.full_name }}" placeholder="Prénom"
        value="{{ registrationForm.prenom.vars.value }}" required>

    <input type="email" name="{{ registrationForm.email.vars.full_name }}" placeholder="Email"
        value="{{ registrationForm.email.vars.value }}" required>

    <input type="password" name="{{ registrationForm.plainPassword.vars.full_name }}" placeholder="Mot de passe"
        required>

    <label>
        <input type="checkbox" name="{{ registrationForm.agreeTerms.vars.full_name }}" {% if
            registrationForm.agreeTerms.vars.value %}checked{% endif %}>
        J’accepte les conditions
    </label>

    <button type="submit">S’inscrire</button>


</form>

<p>
    Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
</p>

{% endblock %}