{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Liste des contrôles de qualité
{% endblock %}


{% block main %}
	{% if partenaires %}
		{% for partenaire in partenaires %}
			<div class="card card-body m-2 d-flex">
				<div class="d-flex justify-content-between">
					<div>
						<h4 class="card-title">{{ partenaire.nom }}</h4>
						<div class="d-flex">
							<p class="mx-1">{{ partenaire.adresse }}</p>
							<p class="mx-1">{{ partenaire.codePostal }}</p>
							<p class="mx-1">{{ partenaire.ville }}</p>
						</div>
						<div class="d-flex">
							<div class="mx-2">
								<h5>Date de début de contrat</h5>
								<p>{{ partenaire.dateValidation|date('Y-m-d H:i:s') }}</p>
							</div>
							<div class="mx-2">
								<h5>Date de fin de contrat</h5>
								<p>{{ partenaire.dateFin|date('Y-m-d H:i:s') }}</p>
							</div>
						</div>

						<div class="d-flex w-100 justify-content-between">
							<div>
								<a href="/admin/quality/accept/{{ partenaire.id }}">
									<button class="btn btn-success">
										Accepté la demande
									</button>
								</a>
								<a href="/admin/quality/deny/{{ partenaire.id }}">
									<button class="btn btn-danger">
										Refusé la demande
									</button>
								</a>
							</div>
							<a href="/admin/entreprise/{{ partenaire.id }}">
								<button class="btn btn-primary">
									Information détaillé de l'entreprise
								</button>
							</a>
						</div>
					</div>
					{% if partenaire.status == "valide" %}
						<span style="height: fit-content;" class="p-1 badge text-bg-success">Validé</span>
					{% endif %}
					{% if partenaire.status == "pre_avis_entreprise" %}
						<span style="height: fit-content;" class="p-1 badge text-bg-warning">Pré Avis</span>
					{% endif %}
					{% if partenaire.status == "pre_avis_newworld" %}
						<span style="height: fit-content;" class="p-1 badge text-bg-warning">Pré Avis</span>
					{% endif %}
				</div>
			</div>
		{% endfor %}
	{% else %}
		<p>Aucune entreprise en contrôle qualité</p>
	{% endif %}
{% endblock %}
