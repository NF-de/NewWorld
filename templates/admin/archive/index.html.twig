{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Liste des partenaires archivé de New World
{% endblock %}


{% block main %}
	{% if partenaires %}
		{% for partenaire in partenaires %}
			<div class="card card-body m-2 d-flex">
				<div class="">
					<h4 class="card-title">{{ partenaire.nom }}</h4>
					<div class="d-flex">
						<p class="mx-2">{{ partenaire.adresse }}</p>
						<p class="mx-2">{{ partenaire.codePostal }}</p>
						<p class="mx-2">{{ partenaire.ville }}</p>
					</div>
					<div class="d-flex">
						<div class="mx-2">
							<h5>Date de début de contrat</h5>
							<p>{{ partenaire.dateValidation|date('Y-m-d H:i:s') }}</p>
						</div>
						<div class="mx-2">
							<h5>Date de fin de contrat</h5>
							{# <p>{{ partenaire.dateValidation|date('Y-m-d H:i:s') }}</p> #}
						</div>
					</div>
				</div>
				<a href="/admin/entreprise/{{ partenaire.id }}">
					<button class="btn btn-primary">
						Voir l'entreprise
					</button>
				</a>
			</div>
		{% endfor %}
	{% else %}
		<p>Aucune entreprise archivé</p>
	{% endif %}


{% endblock %}
